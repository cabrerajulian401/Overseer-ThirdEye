# dbmate and the dbmate CLI read this file directly; the server only reads
# real environment variables — `make run` sources this file before starting it.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/overseer?sslmode=disable"

# Anthropic API key for gateway/llm (read by the SDK).
ANTHROPIC_API_KEY=""

# Optional overrides
PORT="8080"
LLM_MODEL="claude-opus-4-8"
SEED_ACCOUNT_NAME="ThirdEye Dev"
SEED_USER_EMAIL="operator@example.com"
# debug logs raw LLM responses ("llm raw response" lines); default info.
LOG_LEVEL="info"
